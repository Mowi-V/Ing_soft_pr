PORT=8081
SECRETORPRIVATEKEY=cambia_esta_clave_secreta_jwt

# Base de datos MySQL 8.0
DB_NAME=db_bienestar
DB_USER=usuario_mysql
DB_PASSWORD=password_mysql
DB_HOST=localhost
DB_PORT=3306

# Correo SMTP (Nodemailer)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password

# ImageKit.io
IMAGEKIT_PUBLIC_KEY=tu_public_key
IMAGEKIT_PRIVATE_KEY=tu_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# URL pública del frontend para enlaces de recuperación
FRONTEND_URL=http://localhost:5173

# Límite máximo de solicitudes en estado Pendiente ('P') solapadas por franja en un proveedor
MAX_PENDIENTES_SOLAPADAS=3
